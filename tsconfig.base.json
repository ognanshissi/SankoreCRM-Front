      "@talisoft/ui/checkbox": ["./packages/shared/ui/checkbox/index.ts"],
      "@talisoft/ui/confirm-dialog": [
        "./packages/shared/ui/confirm-dialog/index.ts"
      ],
      "@talisoft/ui/container": ["./packages/shared/ui/container/index.ts"],
      "@talisoft/ui/core": ["./packages/shared/ui/core/index.ts"],
      "@talisoft/ui/date-picker": ["./packages/shared/ui/date-picker/index.ts"],
